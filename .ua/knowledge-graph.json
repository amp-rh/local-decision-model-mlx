 "tour": [
  {
   "order": 1,
   "title": "Project Overview",
   "description": "Start with the README: what a Jev-style decision classifier is, the fully-local MLX pipeline (data -> chat-format -> train -> serve -> eval), and the strict model contract (output exactly {\"label\", \"key\"}).",
   "nodeIds": [
    "document:README.md"
   ]
  },
  {
   "order": 2,
   "title": "Design Intent & Decisions",
   "description": "Read the design doc and the two ADRs to understand why MLX LoRA on Apple Silicon and why the system prompt is baked into training data (no train/serve drift).",
   "nodeIds": [
    "document:docs/design.md",
    "document:docs/adr/0001-mlx-lora-on-apple-silicon.md",
    "document:docs/adr/0002-unified-schema-and-baked-system-prompt.md"
   ]
  },
  {
   "order": 3,
   "title": "Pipeline Entry Point",
   "description": "The Makefile is the single CLI: make data, chat-format, train, serve, eval, plus the check quality gate that fans out to lint/type/security/test.",
   "nodeIds": [
    "file:Makefile"
   ]
  },
  {
   "order": 4,
   "title": "Dataset Construction",
   "description": "build_dataset.py samples ~35k examples: five HF dataset adapters (multinli, boolq, banking77, agnews, sst5) plus two synthetic generators (programmatic_policies, routing), all normalized through rec() into the unified schema and written to train/dev JSONL by main().",
   "nodeIds": [
    "file:src/local_decision_model/build_dataset.py",
    "function:src/local_decision_model/build_dataset.py:main",
    "function:src/local_decision_model/build_dataset.py:programmatic_policies"
   ]
  },
  {
   "order": 5,
   "title": "Chat-Format Conversion",
   "description": "to_mlx_chat.py converts unified records to MLX chat JSONL. The key invariant: to_example bakes the exact inference system prompt into every training example, and the assistant reply is exactly {\"label\", \"key\"}.",
   "nodeIds": [
    "file:src/local_decision_model/to_mlx_chat.py",
    "function:src/local_decision_model/to_mlx_chat.py:to_example",
    "function:src/local_decision_model/to_mlx_chat.py:format_options"
   ]
  },
  {
   "order": 6,
   "title": "Training & Serving on the Mac",
   "description": "Two thin shell scripts wrap mlx-lm: 04_train.sh LoRA fine-tunes (rank 32, ~4.7k iters, env-overridable), 05_fuse_serve.sh fuses the adapter and serves an OpenAI-compatible endpoint on localhost:8080.",
   "nodeIds": [
    "file:scripts/04_train.sh",
    "file:scripts/05_fuse_serve.sh"
   ]
  },
  {
   "order": 7,
   "title": "Evaluation",
   "description": "evaluate.py queries the local server for every dev record (temperature=0, max_tokens=8), scores per-source accuracy with a lenient bare-letter fallback, and reports malformed-output rate and mean latency.",
   "nodeIds": [
    "file:src/local_decision_model/evaluate.py",
    "function:src/local_decision_model/evaluate.py:query",
    "function:src/local_decision_model/evaluate.py:main"
   ]
  },
  {
   "order": 8,
   "title": "Tests",
   "description": "tests/test_pipeline.py is fully offline: schema-shape checks for every generator, the damaged-item policy override invariant, and the system-prompt/contract invariants of the chat converter.",
   "nodeIds": [
